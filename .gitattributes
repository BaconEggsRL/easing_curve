# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Only include the addons folder when downloading from the Asset Library.
/**        export-ignore
/addons    !export-ignore
/addons/** !export-ignore

# This repository also contains local Codex tooling. It is not part of the
# Easing Curve distribution.
/addons/godot_ai export-ignore
/addons/godot_ai/** export-ignore

# Preserve the two files already committed as Git LFS objects. Repository
# images and addon assets otherwise remain ordinary Git blobs.
/media/icon_32x32.png filter=lfs diff=lfs merge=lfs -text
/media/icon_128x128.png filter=lfs diff=lfs merge=lfs -text
