# Godot 4+ specific ignores
.godot/
/android/
/_exports/
_media/
test/_temp/*
!test/_temp/.gdignore

# Local secrets
.env
.env.*
!.env.example
addons/godot_ai_tunnel/tunnel_config.json

# Native v2 spike build products
/native/.sconsign.dblite
/native/.toolchains/
/native/src/*.obj
/native/src/*.o
/native/src/*.os
/native/src/*.obj.import
/addons/easing_curve/bin/*.dll
/addons/easing_curve/bin/*.exp
/addons/easing_curve/bin/*.lib
/addons/easing_curve/bin/*.pdb
/addons/easing_curve/bin/*.so
/addons/easing_curve/bin/*.dylib
/addons/easing_curve/bin/*.wasm
/addons/easing_curve/bin/~*.TMP
